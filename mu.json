{
  "toolchains": [
    {
      "toolchain": "bb",
      "from": "scratch",
      "config": {
        "version": "1.12.216",
        "url": "https://github.com/babashka/babashka/releases/download/v1.12.216/babashka-1.12.216-macos-aarch64.tar.gz",
        "sha256": "91499b3f430038f9b40e433215256a6e5392942780dca9984d493d2bcca7055d"
      }
    },
    {
      "toolchain": "go",
      "from": "scratch",
      "config": {
        "version": "1.25.8",
        "url": "https://go.dev/dl/go1.25.8.darwin-arm64.tar.gz",
        "sha256": "c6547959f5dbe8440bf3da972bd65ba900168de5e7ab01464fbdc7ac8375c21c",
        "strip_prefix": "go"
      }
    }
  ],
  "plugins": [
    {"name": "go", "script": "plugins/go/plugin.bb"}
  ],
  "targets": [
    {
      "target": "//cmd/mu",
      "toolchain": "go",
      "sources": [
        "go.mod",
        "go.sum",
        "cmd/mu/main.go",
        "cmd/mu/build.go",
        "cmd/mu/scratch.go",
        "internal/builtin/fetch.go",
        "internal/cas/cas.go",
        "internal/cas/oci/oci.go",
        "internal/config/loader.go",
        "internal/config/preprocess.go",
        "internal/config/types.go",
        "internal/config/validate.go",
        "internal/coordinator/coordinator.go",
        "internal/coordinator/resolve.go",
        "internal/coordinator/toolchain.go",
        "internal/dag/actionkey.go",
        "internal/dag/executor.go",
        "internal/dag/graph.go",
        "internal/dag/topo.go",
        "internal/plugin/manager.go",
        "internal/plugin/process.go",
        "internal/plugin/protocol.go",
        "internal/sandbox/sandbox.go",
        "internal/scratch/external.go",
        "internal/scratch/scratch.go"
      ],
      "config": {
        "output": "mu",
        "pkg": "./cmd/mu",
        "trimpath": true
      }
    },
    {
      "target": "//plugins/go",
      "toolchain": "shell",
      "sources": ["plugins/go/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/go/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/cowsay",
      "toolchain": "shell",
      "sources": ["plugins/cowsay/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/cowsay/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/docker",
      "toolchain": "shell",
      "sources": ["plugins/docker/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/docker/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/file",
      "toolchain": "shell",
      "sources": ["plugins/file/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/file/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/k8s",
      "toolchain": "shell",
      "sources": ["plugins/k8s/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/k8s/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/zig",
      "toolchain": "shell",
      "sources": ["plugins/zig/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/zig/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/terraform",
      "toolchain": "shell",
      "sources": ["plugins/terraform/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/terraform/plugin.bb", "plugin.bb"],
        "outputs": ["plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/scratch",
      "toolchain": "shell",
