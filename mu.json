    },
    {
      "target": "//plugins",
      "toolchain": "shell",
      "sources": [],
      "deps": [
        "//plugins/go",
        "//plugins/cowsay",
        "//plugins/docker",
        "//plugins/file",
        "//plugins/k8s",
        "//plugins/zig",
        "//plugins/terraform",
        "//plugins/scratch"
      ],
      "config": {
        "command": ["true"],
        "impure": false
      }
    }
  ]
}
