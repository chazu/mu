{
  "toolchains": [
    {
      "toolchain": "bb",
      "from": "scratch",
      "config": {
        "version": "1.12.216",
        "url": "https://github.com/babashka/babashka/releases/download/v1.12.216/babashka-1.12.216-macos-aarch64.tar.gz",
        "sha256": "91499b3f430038f9b40e433215256a6e5392942780dca9984d493d2bcca7055d"
      }
    },
    {
      "toolchain": "go",
      "from": "scratch",
      "config": {
        "version": "1.25.8",
        "url": "https://go.dev/dl/go1.25.8.darwin-arm64.tar.gz",
        "sha256": "c6547959f5dbe8440bf3da972bd65ba900168de5e7ab01464fbdc7ac8375c21c",
        "strip_prefix": "go"
      }
    }
  ],
  "plugins": [
    {"name": "go", "script": "plugins/go/plugin.bb"},
    {"name": "lint", "script": "plugins/lint/plugin.bb"}
  ],
  "targets": [
    {
      "target": "//cmd/mu",
      "toolchain": "go",
      "sources": [
        "go.mod",
        "go.sum",
        "cmd/mu/*.go",
        "internal/builtin/*.go",
        "internal/cas/*.go",
        "internal/cas/oci/*.go",
        "internal/config/*.go",
        "internal/coordinator/*.go",
        "internal/dag/*.go",
        "internal/plugin/*.go",
        "internal/sandbox/*.go",
        "internal/scratch/*.go"
      ],
      "config": {
        "output": "mu",
        "pkg": "./cmd/mu",
        "trimpath": true
      }
    },
    {
      "target": "//plugins/go",
      "toolchain": "shell",
      "sources": ["plugins/go/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/go/plugin.bb", "go-plugin.bb"],
        "outputs": ["go-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/cowsay",
      "toolchain": "shell",
      "sources": ["plugins/cowsay/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/cowsay/plugin.bb", "cowsay-plugin.bb"],
        "outputs": ["cowsay-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/docker",
      "toolchain": "shell",
      "sources": ["plugins/docker/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/docker/plugin.bb", "docker-plugin.bb"],
        "outputs": ["docker-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/file",
      "toolchain": "shell",
      "sources": ["plugins/file/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/file/plugin.bb", "file-plugin.bb"],
        "outputs": ["file-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/k8s",
      "toolchain": "shell",
      "sources": ["plugins/k8s/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/k8s/plugin.bb", "k8s-plugin.bb"],
        "outputs": ["k8s-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/zig",
      "toolchain": "shell",
      "sources": ["plugins/zig/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/zig/plugin.bb", "zig-plugin.bb"],
        "outputs": ["zig-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/terraform",
      "toolchain": "shell",
      "sources": ["plugins/terraform/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/terraform/plugin.bb", "terraform-plugin.bb"],
        "outputs": ["terraform-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/scratch",
      "toolchain": "shell",
      "sources": ["plugins/scratch/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/scratch/plugin.bb", "scratch-plugin.bb"],
        "outputs": ["scratch-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins/lint",
      "toolchain": "shell",
      "sources": ["plugins/lint/plugin.bb"],
      "config": {
        "command": ["cp", "plugins/lint/plugin.bb", "lint-plugin.bb"],
        "outputs": ["lint-plugin.bb"],
        "impure": false
      }
    },
    {
      "target": "//plugins",
      "toolchain": "shell",
      "sources": [],
      "deps": [
        "//plugins/go",
        "//plugins/cowsay",
        "//plugins/docker",
        "//plugins/file",
        "//plugins/k8s",
        "//plugins/zig",
        "//plugins/terraform",
        "//plugins/scratch",
        "//plugins/lint"
      ],
      "config": {
        "command": ["true"],
        "impure": false
      }
    },
    {
      "target": "//lint/go-vet",
      "toolchain": "lint",
      "sources": ["cmd/mu/*.go", "internal/**/*.go"],
      "config": {
        "command": ["go", "vet", "./..."]
      }
    },
    {
      "target": "//lint/gofmt",
      "toolchain": "lint",
      "sources": ["cmd/mu/*.go", "internal/**/*.go"],
      "config": {
        "command": ["gofmt", "-l", "."],
        "fix_command": ["gofmt", "-w", "."]
      }
    },
    {
      "target": "//lint",
      "toolchain": "shell",
      "kind": "kit",
      "sources": [],
      "deps": ["//lint/go-vet", "//lint/gofmt"],
      "config": {
        "command": ["true"],
        "impure": false
      }
    }
  ]
}
